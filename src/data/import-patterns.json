{
  "importPatterns": {
    "typescript": [
      "import\\s+(?:type\\s+)?(?:(?:\\w+\\s*,\\s*)?(?:\\{[^}]*\\}|\\*\\s+as\\s+\\w+|\\w+)\\s+from\\s+)?['\"]([^'\"]+)['\"]",
      "require\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\)",
      "import\\s*\\(\\s*['\"]([^'\"]+)['\"]",
      "export\\s+(?:type\\s+)?(?:\\*|\\{[^}]*\\})\\s+from\\s+['\"]([^'\"]+)['\"]"
    ],
    "javascript": [
      "import\\s+(?:type\\s+)?(?:(?:\\w+\\s*,\\s*)?(?:\\{[^}]*\\}|\\*\\s+as\\s+\\w+|\\w+)\\s+from\\s+)?['\"]([^'\"]+)['\"]",
      "require\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\)",
      "import\\s*\\(\\s*['\"]([^'\"]+)['\"]",
      "export\\s+(?:type\\s+)?(?:\\*|\\{[^}]*\\})\\s+from\\s+['\"]([^'\"]+)['\"]"
    ],
    "python": ["^import\\s+(\\S+)", "^from\\s+(\\S+)\\s+import"],
    "go": [
      "import\\s+(?:\\w+\\s+)?[\"']([^\"']+)[\"']",
      "import\\s+\\(\\s*(?:[\\s\\S]*?[\"']([^\"']+)[\"'])+\\s*\\)"
    ]
  },
  "extToLang": {
    ".ts": "typescript",
    ".tsx": "typescript",
    ".js": "javascript",
    ".jsx": "javascript",
    ".mjs": "javascript",
    ".cjs": "javascript",
    ".py": "python",
    ".go": "go"
  }
}
