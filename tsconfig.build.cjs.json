{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "NodeNext",
    "outDir": "dist/cjs",
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "src/cli.ts"]
}
